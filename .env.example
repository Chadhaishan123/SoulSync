# ============================================================
# SoulSync — Environment Configuration
# Copy this file to  backend/.env  and adjust as needed.
#
# EVERY third-party key stays SERVER-SIDE. Never expose one to
# the browser. Optional keys may be left blank — SoulSync falls
# back to keyless providers (Open-Meteo, Nager.Date) which need
# no registration and have no rate anxiety.
# ============================================================

# --- Runtime ---------------------------------------------------
# "development" | "production"
# In production the app REFUSES to boot with the dev SECRET_KEY.
ENVIRONMENT=development

# --- Security --------------------------------------------------
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-key-change-before-any-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Database --------------------------------------------------
# Default is zero-setup SQLite. To use PostgreSQL instead:
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/soulsync
# Leave blank to use SQLite at backend/soulsync.db
DATABASE_URL=

# --- Rate limiting ---------------------------------------------
# Optional. Leave blank to use in-memory limiting (fine for localhost).
REDIS_URL=

# --- CORS ------------------------------------------------------
# Comma-separated exact origins. Wildcards are NOT used: "*" with
# credentials is rejected by browsers.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Real-time APIs (keyless, always available) -----------------
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
NAGER_DATE_URL=https://date.nager.at/api/v3

# --- Optional free-key APIs (blank = feature degrades cleanly) --
# Reverse-geocode lat/lon into a real city name — https://opencagedata.com/
OPENCAGE_API_KEY=
# Pollen / allergen levels — https://www.tomorrow.io/weather-api/
TOMORROW_IO_API_KEY=

# --- NLP / AI engine -------------------------------------------
# true  = load DistilBERT emotion + sentiment transformers (~500 MB first run)
# false = use the TF-IDF + lexicon engine only (no download)
ENABLE_TRANSFORMER_NLP=true
EMOTION_MODEL=bhadresh-savani/distilbert-base-uncased-emotion
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Companion reply engine: "local" | "template" | "ollama" | "claude"
#   local    = FLAN-T5 generation grounded in your real data (~1 GB first run)
#   template = grounded templates only, no model download
COMPANION_ENGINE=local
COMPANION_MODEL=google/flan-t5-base
# Only needed when COMPANION_ENGINE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Only needed when COMPANION_ENGINE=claude
ANTHROPIC_API_KEY=

# Where downloaded model weights are cached (blank = HuggingFace default)
HF_HOME=

# --- Environment data caching ----------------------------------
# How long a weather/AQI reading may be reused for the same coordinates.
# Responses always report fetched_at and cache_age_seconds, so a cached
# value is never passed off as a fresh one.
ENV_CACHE_TTL_SECONDS=600
HOLIDAY_CACHE_TTL_SECONDS=86400

# --- Geolocation -----------------------------------------------
# There is deliberately no default latitude/longitude. Environment
# endpoints use the user's real browser coordinates or return an explicit
# "location needed" response. A hardcoded fallback city would make every
# weather reading silently wrong for anyone living elsewhere.

# --- Frontend (set in frontend/.env.local, not here) ------------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
